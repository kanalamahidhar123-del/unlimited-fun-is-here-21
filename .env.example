# Unlimited Fun Environment Variables Example
# Duplicate this file to .env and fill in your keys

# Payment Mode: 'PAYMENT_REQUIRED' or 'REGISTRATION_ONLY'
VITE_PAYMENT_MODE=PAYMENT_REQUIRED
PAYMENT_MODE=PAYMENT_REQUIRED

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Google Sheets Webhook Sync (Optional)
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/your_script_id/exec

# Supabase (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
